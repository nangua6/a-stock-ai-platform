# ========================
# Application Environment
# ========================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ========================
# Database
# ========================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/astock_ai

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# MiMo AI Configuration
# ========================
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.mimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# ========================
# Market Data Provider
# ========================
MARKET_DATA_PROVIDER=tushare
MARKET_DATA_API_KEY=your_market_data_api_key_here
MARKET_DATA_FALLBACK_ENABLED=true

# ========================
# Broker Configuration
# ========================
BROKER_PROVIDER=mock
BROKER_API_URL=
BROKER_ACCOUNT_ID=
BROKER_API_KEY=
BROKER_API_SECRET=

# ========================
# Trading Safety Defaults
# ========================
PAPER_TRADING=true
LIVE_TRADING=false
AUTO_TRADE=false
GLOBAL_KILL_SWITCH=true
LIVE_ORDER_REQUIRE_CONFIRMATION=true

# ========================
# Risk Control Defaults
# ========================
MAX_POSITION_RATIO=0.20
MAX_SINGLE_TRADE_AMOUNT=100000
MAX_DAILY_LOSS_RATIO=0.03
MAX_DRAWDOWN=0.10
MAX_DAILY_ORDERS=20
MAX_INDUSTRY_EXPOSURE=0.40

# ========================
# Trading Hours (Asia/Shanghai)
# ========================
TZ=Asia/Shanghai
